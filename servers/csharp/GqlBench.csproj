<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Exact versions of every package, including indirect ones, are pinned in packages.lock.json -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- One core, like the Node and Python servers: one thread pool thread runs all request work,
         as Node's single JavaScript thread does, and workstation GC replaces the default server GC,
         which collects on many threads at once -->
    <ThreadPoolMinThreads>1</ThreadPoolMinThreads>
    <ThreadPoolMaxThreads>1</ThreadPoolMaxThreads>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.8" />
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="16.6.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
